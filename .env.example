# FM Validator — Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Drive (required)
# Create OAuth2 Desktop App credentials at console.cloud.google.com
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id-here

# Email notifications via Resend (required)
RESEND_API_KEY=re_your-key-here
NOTIFY_EMAIL=you@youremail.com

# Server (optional — defaults shown)
PORT=3000

# CORS — set to your VPS domain before deployment
ALLOWED_ORIGIN=https://plsfx.ai
VALIDATOR_API_KEY=your-secret-key-here

# Stripe hosted Checkout — inject credentials using the hosting secret store.
# Prefer a restricted key with only Account read, Product read, and Checkout Session write/read.
# Sandbox/test and live IDs, products, API keys and signing secrets MUST all match.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_PRODUCT_ID=
STRIPE_LIVE_MODE=false
PUBLIC_CHECKOUT_BASE_URL=https://plsfx.ai/fm-validator
# Optional Dashboard-managed payment-method configuration; dynamic methods otherwise apply.
STRIPE_PAYMENT_METHOD_CONFIGURATION=
# Enable after credentials and webhook setup; runs on startup and at minute15 each hour.
STRIPE_RECONCILIATION_ENABLED=false
# Persist with orders/uploads on one shared local filesystem; defaults shown in the runbook.
# PAYMENT_DATA_DIR=/persistent/path/payment-state
# ORDER_DATA_DIR=/persistent/path/orders

# Separate admin application (localhost listener), also protected by the reverse proxy.
ADMIN_USERNAME=
ADMIN_PASSWORD=
